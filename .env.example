# LEVLA — miljövariabler
# Kopiera denna fil till .env (eller .env.local) och fyll i värdena från
# Supabase: Project Settings → Data API / API Keys.
#
#   cp .env.example .env
#
# Båda värdena är PUBLIKA (de bakas in i appbygget). RLS-policies skyddar datan.
# Lägg ALDRIG service_role-nyckeln här — den kringgår RLS.

EXPO_PUBLIC_SUPABASE_URL=https://<ditt-projekt-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<din-anon-eller-publishable-key>
